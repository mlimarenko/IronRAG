# The IronRAG release this connector runs with. Required: the image tag is the
# stack version, and a default would quietly serve a build you did not choose.
# Use the release tag exactly as published, including the leading v.
IRONRAG_VERSION=v0.6.0

# Copy to `.env.local` and fill in.

# --- IronRAG ---
IRONRAG_BASE_URL=http://localhost:19000
IRONRAG_API_TOKEN=changeme
ADMIN_BEARER_TOKEN=changeme

# --- Routing + repos ---
ROUTING_CONFIG_PATH=/app/routing.yaml
GITREPOS_CONFIG_PATH=/app/repos.yaml
# Bare clones live in the state volume: the container runs as uid 10001 and
# cannot write /app, and a path outside the volume would re-clone every restart.
GITREPOS_CLONE_ROOT=/var/lib/ironrag-connector/repo-cache

# --- Sync loop ---
RUN_MODE=poll
SYNC_INTERVAL_SECONDS=1800
SYNC_RUN_ON_STARTUP=true
SYNC_CONCURRENCY=4
SYNC_ITEM_TIMEOUT_SECONDS=300
SYNC_ITEM_RETRY_TIMEOUT_SECONDS=30
OPERATION_POLL_INTERVAL_SECONDS=1
OPERATION_POLL_BUDGET_SECONDS=120
REWALK_CONCURRENCY=4
REAPER_LIST_TIMEOUT_SECONDS=60

# --- Limits ---
GITREPOS_FETCH_TIMEOUT_SECONDS=180
GITREPOS_COMMAND_TIMEOUT_SECONDS=60
GITREPOS_MAX_FILE_BYTES=1048576

# --- Server / persistence ---
HOST=0.0.0.0
PORT=8088
LOG_LEVEL=info
STATE_DB_PATH=/var/lib/ironrag-connector/state.sqlite

# --- Default per-kind policy (overridable in routing.yaml) ---
DEFAULT_POLICY_ON_NEW=create
DEFAULT_POLICY_ON_CHANGED=replace
DEFAULT_POLICY_ON_MISSING=delete
DEFAULT_POLICY_ON_DUPLICATE_CONTENT=skip

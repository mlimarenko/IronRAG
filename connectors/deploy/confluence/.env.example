# The IronRAG release this connector runs with. Required: the image tag is the
# stack version, and a default would quietly serve a build you did not choose.
# Use the release tag exactly as published, including the leading v.
IRONRAG_VERSION=v0.6.0

CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_AUTH_MODE=auto
# For basic auth:
# CONFLUENCE_USERNAME=user@example.com
# CONFLUENCE_PASSWORD=...
# or CONFLUENCE_TOKEN=...
# For bearer auth:
# CONFLUENCE_TOKEN=...

# Optional source filtering:
# CONFLUENCE_SPACE_KEYS=all            # all spaces (default when omitted)
# CONFLUENCE_SPACE_KEYS=ENG,DOCS
# CONFLUENCE_EXCLUDE_SPACE_KEYS=ARCHIVE
# CONFLUENCE_CQL=label = "public"
# CONFLUENCE_INCLUDE_ATTACHMENTS=true

IRONRAG_BASE_URL=http://localhost:19000
IRONRAG_API_TOKEN=change-me
# Asynchronous IronRAG mutations (revision, delete) are accepted with 202 and
# polled to completion; tune the poll cadence and overall budget here.
OPERATION_POLL_INTERVAL_SECONDS=1.0
OPERATION_POLL_BUDGET_SECONDS=120
# REWALK_CONCURRENCY=4
ADMIN_BEARER_TOKEN=change-me

RUN_MODE=poll
SYNC_INTERVAL_SECONDS=1800
SYNC_ITEM_TIMEOUT_SECONDS=300
SYNC_ITEM_RETRY_TIMEOUT_SECONDS=30
REAPER_LIST_TIMEOUT_SECONDS=60

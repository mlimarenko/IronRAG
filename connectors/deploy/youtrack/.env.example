# The IronRAG release this connector runs with. Required: the image tag is the
# stack version, and a default would quietly serve a build you did not choose.
# Use the release tag exactly as published, including the leading v.
IRONRAG_VERSION=v0.6.0

# --- YouTrack Knowledge Base and Tasks ---
YOUTRACK_BASE_URL=https://tracker.example.com/youtrack
# Permanent token scoped to YouTrack. For every project admitted below, the
# token user needs Read Project Basic, Read Article and Read Issue, plus Read
# Article Comment / Read Issue Comment for each kind whose comment sync is on
# (routing.yaml policies.<kind>.include_comments, default true). It must also
# be able to read every in-scope attachment descriptor and linked issue
# target. YouTrack comment
# endpoints return all comments accessible to this account; an article exposes
# no independent comment-count invariant, so wiki-comment completeness requires
# an explicit permission/audience admission. These source permissions do not
# prove that IronRAG's readers are a subset of YouTrack's readers.
YOUTRACK_TOKEN=perm:replace-me
YOUTRACK_PAGE_SIZE=100 # integer 1..500
YOUTRACK_RETRY_MAX=5 # integer 0..20
YOUTRACK_RETRY_BACKOFF_SECONDS=1 # number >= 0.1
YOUTRACK_RETRY_MAX_SLEEP_SECONDS=30 # number >= 0.1
YOUTRACK_MIN_REQUEST_INTERVAL_SECONDS=0.1 # number >= 0
# Integer 2 or 3; matching snapshots protect offset pagination from mutation.
# Articles require an exact content-token match across passes; issues (which
# churn far more) only require the set of issue IDs to hold -- see
# `ironrag_connector.sources.youtrack.adapter._stable_issue_snapshot`.
YOUTRACK_SNAPSHOT_VALIDATION_PASSES=2
# Group-based scope, shared by both article and issue sync. Optional exact
# project database IDs and/or short names, comma-separated.
YOUTRACK_PROJECTS=
YOUTRACK_EXCLUDE_PROJECTS=
YOUTRACK_INCLUDE_ARCHIVED_PROJECTS=false # true | false
# Point selection, ANDed with the project scope above: when set, only items
# (article or issue) carrying this exact YouTrack tag sync, regardless of
# project. Case-sensitive, exact match. Leave unset to sync by project scope
# alone -- this is the default and does not change existing behaviour.
YOUTRACK_REQUIRE_TAG=
# Exact allowlist of issue custom-field names admitted to routing and indexed
# metadata. An empty value requests none; the connector never falls back to
# every project field.
YOUTRACK_CUSTOM_FIELDS=Type,State,Priority,Assignee

# --- IronRAG ---
IRONRAG_BASE_URL=https://ironrag.example.com
IRONRAG_API_TOKEN=irt_replace_me
REQUEST_TIMEOUT_SECONDS=60 # number >= 1
# Async mutations (revisions, deletes) are polled to a terminal state.
OPERATION_POLL_INTERVAL_SECONDS=1 # number >= 0.05
OPERATION_POLL_BUDGET_SECONDS=120 # number >= 1
REWALK_CONCURRENCY=4 # integer 1..64
REAPER_LIST_TIMEOUT_SECONDS=30 # number >= 1

# --- Routing and reconciliation ---
ROUTING_CONFIG_PATH=/app/routing.yaml
RUN_MODE=poll # poll is required: YouTrack KB has no lifecycle webhooks
SYNC_INTERVAL_SECONDS=1800 # integer >= 60
SYNC_RUN_ON_STARTUP=false # true | false
SYNC_CONCURRENCY=4 # integer 1..64
SYNC_ITEM_TIMEOUT_SECONDS=300 # number >= 1
SYNC_ITEM_RETRY_TIMEOUT_SECONDS=30 # number >= 1
DEFAULT_POLICY_ON_NEW=create # create | skip
DEFAULT_POLICY_ON_CHANGED=replace # replace | skip
DEFAULT_POLICY_ON_MISSING=delete # delete | ignore
DEFAULT_POLICY_ON_DUPLICATE_CONTENT=skip # skip | fail

# --- State and HTTP admin surface ---
STATE_DB_PATH=/var/lib/ironrag-connector/state.sqlite
HOST=0.0.0.0
PORT=8088
LOG_LEVEL=info
# Optional filesystem path; defaults to /tmp/<connector-name>.pid.
# PIDFILE_PATH=/tmp/youtrack-connector.pid
ADMIN_BEARER_TOKEN=replace-me

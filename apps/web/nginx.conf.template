map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 100M;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        application/wasm
        image/svg+xml
        text/css
        text/plain;

    include /etc/nginx/snippets/ironrag-security-headers.conf;

    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }

    location ~* ^/(?:actuator|debug/pprof|metrics|nginx_status|server-status)(?:/|$) {
        return 404;
    }

    location ~ ^/v1/content/libraries/[^/]+/snapshot$ {
        client_max_body_size 0;
        gzip off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_send_timeout 1800s;
        proxy_read_timeout 1800s;
        send_timeout 1800s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass ${IRONRAG_API_UPSTREAM};
    }

    # POST /v1/ops/ingest-queue/jobs/{jobId}/execute runs that job's whole
    # pipeline inside the request and answers only afterwards
    # (apps/api/src/interfaces/http/ops.rs). Connectors wait for the answer
    # under their own EXECUTE_INGEST_JOB_TIMEOUT_SECONDS budget, default
    # 1800 s, so the generic /v1/ read budget would cut the request first.
    # nginx sends this mutation to the single API upstream once and does not
    # re-send it after a timeout; a repeat stays the operator's decision.
    location ~ ^/v1/ops/ingest-queue/jobs/[^/]+/execute$ {
        include /etc/nginx/snippets/ironrag-api-proxy.conf;
        proxy_read_timeout 1800s;
        proxy_pass ${IRONRAG_API_UPSTREAM};
    }

    location /v1/ {
        include /etc/nginx/snippets/ironrag-api-proxy.conf;
        proxy_read_timeout 300s;
        proxy_pass ${IRONRAG_API_UPSTREAM};
    }

    # Browser telemetry. The OTLP collectors are internal-only; the web pod is
    # the single same-origin entry point so the CSP needs no third-party host.
    # /otlp/v1/traces -> <upstream>/v1/traces.
    location /otlp/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 30s;
        proxy_pass ${IRONRAG_OTLP_UPSTREAM}/;
    }

    # Source maps are release artifacts, not public assets.
    location ~* \.map$ {
        return 404;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/ironrag-security-headers.conf;
        try_files $uri =404;
    }

    location = /swagger.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http: https: ws: wss:; worker-src 'self' blob:" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files /swagger.html =404;
    }

    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        include /etc/nginx/snippets/ironrag-security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}

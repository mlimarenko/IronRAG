{
  "name": "ironrag-frontend",
  "private": true,
  "version": "0.6.0",
  "packageManager": "npm@11.17.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "format:check": "prettier --check .",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.e2e.json --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "swagger:sync": "node scripts/sync-swagger-ui.mjs",
    "swagger:check": "node scripts/sync-swagger-ui.mjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts && node scripts/check-e2e-spec-counts.mjs test-results/e2e-report.json",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "test:qa": "playwright test --config=playwright.qa.config.ts",
    "test:qa:ui": "playwright test --config=playwright.qa.config.ts --ui",
    "test:watch": "vitest",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "size-limit": "size-limit",
    "deadcode": "knip --reporter compact",
    "test:e2e:run": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/context-zone-peer-dep": "^2.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-document-load": "^0.65.0",
    "@opentelemetry/instrumentation-fetch": "^0.220.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.64.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@tanstack/react-query": "^5.101.2",
    "i18next": "^26.3.4",
    "lucide-react": "1.68.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "size-limit": [
    {
      "name": "main entry chunk",
      "path": "dist/assets/index-*.js",
      "limit": "150 KB",
      "gzip": true
    },
    {
      "name": "application bootstrap chunk",
      "path": "dist/assets/App-*.js",
      "limit": "150 KB",
      "gzip": true
    },
    {
      "name": "graph feature chunk",
      "path": "dist/assets/GraphPage-*.js",
      "limit": "60 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.97.3",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/eslint-plugin-query": "5.105.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^29.1.1",
    "knip": "^6.24.0",
    "msw": "^2.14.6",
    "prettier": "3.9.10",
    "size-limit": "^12.1.0",
    "source-map-js": "^1.2.2",
    "swagger-ui-dist": "5.34.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "esbuild@0.28.1": true,
    "msw@2.14.6": true
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "minimatch@^10": "11.0.1",
    "@hey-api/json-schema-ref-parser": "1.4.1",
    "@hey-api/shared": "0.4.5",
    "brace-expansion": "5.0.12",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.28.7",
    "undici": "^7.29.1",
    "source-map-js": "^1.2.2",
    "smol-toml": "^1.9.0"
  }
}

# Docker Compose reads this file from the repository root automatically.
# Use only supported IRONRAG_<SETTING> variables (one separator after the prefix); `IRONRAG__*` and lower-case aliases are unsupported.
# A single docker-compose.yml serves every mode (prebuilt images + filesystem
# storage by default); the optional stanzas at the bottom of this file switch on
# the source build, the s4 object-storage profile, or larger memory caps.

# Published HTTP port for frontend -> UI/API/MCP.
IRONRAG_PORT=19000

# Basic stack defaults for the default (filesystem) stack.
# Free-form environment label (e.g. production, staging).
IRONRAG_ENVIRONMENT=production
# IronRAG derives its opaque deployment identity from PostgreSQL. There is no
# operator override: runtime, telemetry and lifecycle evidence must agree.
IRONRAG_POSTGRES_DB=ironrag
IRONRAG_POSTGRES_USER=postgres
IRONRAG_POSTGRES_PASSWORD=postgres
# Optional explicit physical PostgreSQL volume name for a controlled data
# cutover. Leave unset for the default <compose-project>_postgres_data name.
# IRONRAG_POSTGRES_VOLUME_NAME=ironrag_postgres_data_clean_v1
IRONRAG_DATABASE_MAX_CONNECTIONS=20
# Release experiments pin the exact dependency leaf certificates inside the
# measured API process. Each path must contain exactly one PEM certificate.
IRONRAG_DATABASE_TLS_LEAF_CERTIFICATE=
IRONRAG_REDIS_TLS_LEAF_CERTIFICATE=
IRONRAG_QUERY_TURN_MAX_CONCURRENT=32
IRONRAG_QUERY_TURN_ADMISSION_QUEUE=80
IRONRAG_QUERY_TURN_ADMISSION_TIMEOUT_MS=15000
# Postgres server knobs for the bundled container. Keep work_mem small relative
# to max_connections * container memory. `shm_size` must exceed shared_buffers.
# Stage with a 6 GiB Postgres: SHM_SIZE=2g, SHARED_BUFFERS=1GB, WORK_MEM=32MB.
# IRONRAG_POSTGRES_MAX_CONNECTIONS=100
# IRONRAG_POSTGRES_SHM_SIZE=256mb
# IRONRAG_POSTGRES_SHARED_BUFFERS=128MB
# Postgres 18 reads bitmap heap scans asynchronously; the defaults below are
# sized for a small host. On a disk-bound node with SSD/NVMe storage, set these
# through ALTER SYSTEM (they have no compose variable): io_workers=8,
# effective_io_concurrency=256, random_page_cost=1.1, track_io_timing=on.
# See docs/en/CAPACITY-PLANNING.md. io_method=io_uring needs a custom Docker
# seccomp profile and will refuse to start without one.
# IRONRAG_POSTGRES_WORK_MEM=4MB
IRONRAG_LOG_FILTER=info
# Comma-separated allowed browser origins used by UI CORS and the MCP
# Streamable HTTP Origin check. Native MCP clients should omit Origin.
IRONRAG_FRONTEND_ORIGIN=http://127.0.0.1:19000,http://localhost:19000
# Optional configured public API origin; also accepted as an exact MCP Origin.
IRONRAG_OPENAPI_PUBLIC_ORIGIN=
# Optional OIDC SSO. To enable it, uncomment and set every core value below;
# leave them commented to keep OIDC variables absent. Keep the client secret in
# Vault or another deployment secret manager.
# IRONRAG_OIDC_ISSUER_URL=
# IRONRAG_OIDC_CLIENT_ID=
# IRONRAG_OIDC_CLIENT_SECRET=
# IRONRAG_OIDC_REDIRECT_URL=
# IRONRAG_OIDC_REQUIRED_GROUP=
# Optional exact OIDC subject made admin on its first just-in-time login.
# IRONRAG_OIDC_BOOTSTRAP_ADMIN_SUBJECT=
# Optional first-login bootstrap. Login, email, and password must be set together.
IRONRAG_UI_BOOTSTRAP_ADMIN_LOGIN=
IRONRAG_UI_BOOTSTRAP_ADMIN_EMAIL=
IRONRAG_UI_BOOTSTRAP_ADMIN_PASSWORD=
# Optional bootstrap API token: inrg_ followed by 32 hexadecimal characters.
IRONRAG_UI_BOOTSTRAP_ADMIN_API_TOKEN=

# Dedicated master key for encrypting AI account and webhook secrets in
# PostgreSQL. REQUIRED: the API and workers refuse to start without a valid key,
# and every stored credential is a mandatory v3 encryption envelope.
# Strict standard-base64 for exactly 32 random bytes; keep it outside the DB,
# back it up securely, and never derive it from IRONRAG_POSTGRES_PASSWORD.
# Generate one with: openssl rand -base64 32
IRONRAG_CREDENTIAL_MASTER_KEY=
# Optional validated key ID embedded in new v3 envelopes. Defaults to `default`
# when only the master-key variable above is configured.
IRONRAG_CREDENTIAL_MASTER_KEY_ID=
# Rotation-only keyring: at most 8 entries, lowercase key IDs, no whitespace,
# strictly sorted by key ID: old-a=<base64-key>,old-b=<base64-key>
IRONRAG_CREDENTIAL_PREVIOUS_MASTER_KEYS=

# Optional first-run model defaults from the clean-v1 OpenAI seed catalog.
IRONRAG_UI_BOOTSTRAP_EXTRACT_GRAPH_PROVIDER_KIND=openai
IRONRAG_UI_BOOTSTRAP_EXTRACT_GRAPH_MODEL_NAME=gpt-6-luna
IRONRAG_UI_BOOTSTRAP_EMBED_CHUNK_PROVIDER_KIND=openai
IRONRAG_UI_BOOTSTRAP_EMBED_CHUNK_MODEL_NAME=text-embedding-3-large
IRONRAG_UI_BOOTSTRAP_QUERY_COMPILE_PROVIDER_KIND=openai
IRONRAG_UI_BOOTSTRAP_QUERY_COMPILE_MODEL_NAME=gpt-6-luna
IRONRAG_UI_BOOTSTRAP_QUERY_ANSWER_PROVIDER_KIND=openai
IRONRAG_UI_BOOTSTRAP_QUERY_ANSWER_MODEL_NAME=gpt-6-luna
IRONRAG_UI_BOOTSTRAP_AGENT_PROVIDER_KIND=openai
IRONRAG_UI_BOOTSTRAP_AGENT_MODEL_NAME=gpt-6-luna
IRONRAG_UI_BOOTSTRAP_EXTRACT_TEXT_PROVIDER_KIND=openai
IRONRAG_UI_BOOTSTRAP_EXTRACT_TEXT_MODEL_NAME=gpt-6-luna

# Optional provider secrets as strict standard-base64 of one JSON object.
# Provider-kind keys are matched exactly (no case folding or aliases).
IRONRAG_AI_PROVIDER_API_KEYS_JSON_B64=

# Ingestion tuning.
IRONRAG_INGESTION_MAX_PARALLEL_JOBS_GLOBAL=4
IRONRAG_INGESTION_MAX_PARALLEL_JOBS_PER_WORKSPACE=2
IRONRAG_INGESTION_MAX_PARALLEL_JOBS_PER_LIBRARY=1
IRONRAG_DOCLING_PAGE_BATCH_SIZE=10
IRONRAG_DOCLING_PAGE_STREAM_WINDOW_PAGES=40
IRONRAG_DOCLING_MAX_CONCURRENCY=auto
# Bounded wait, in seconds, for one Docling extraction slot before refusing.
IRONRAG_DOCLING_ACQUIRE_TIMEOUT_SECS=1800
IRONRAG_INGESTION_HEAVY_PIPELINE_PARALLELISM=auto
# Bounded wait, in seconds, for one heavy-revision pipeline slot.
IRONRAG_INGESTION_HEAVY_ACQUIRE_TIMEOUT_SECS=1800
IRONRAG_INGESTION_EMBEDDING_PARALLELISM=8
IRONRAG_INGESTION_GRAPH_EXTRACT_PARALLELISM_PER_DOC=16

# Shared per-provider backpressure. Use 0/0 only for explicit unlimited mode.
IRONRAG_PROVIDER_CONCURRENCY_MAX_OUTBOUND=16
IRONRAG_PROVIDER_CONCURRENCY_QUERY_RESERVED=4
IRONRAG_PROVIDER_CONCURRENCY_ACQUIRE_TIMEOUT_MS=30000
IRONRAG_PROVIDER_CONCURRENCY_REGISTRY_MAX_ENTRIES=64
IRONRAG_PROVIDER_CONCURRENCY_REGISTRY_IDLE_TTL_SECONDS=900
IRONRAG_PROVIDER_RATE_LIMIT_REQUESTS_PER_SECOND=8
IRONRAG_PROVIDER_RATE_LIMIT_BURST=16
IRONRAG_PROVIDER_RETRY_MAX_ATTEMPTS=3
IRONRAG_PROVIDER_RETRY_INITIAL_BACKOFF_MS=200
IRONRAG_PROVIDER_RETRY_MAX_BACKOFF_MS=5000

# Retrieval tuning.
# Filtered pgvector HNSW scans are bounded. Raise the tuple/memory bounds only
# after checking query p95 and database memory. Exact retry is limited to small
# logical lanes; set its row threshold to 0 to disable it.
# Build-time HNSW index memory budget. Default: 3000000000 bytes.
IRONRAG_PG_HNSW_BUILD_BUDGET_BYTES=3000000000
IRONRAG_PG_HNSW_EF_SEARCH=400
IRONRAG_PG_HNSW_MAX_SCAN_TUPLES=50000
IRONRAG_PG_HNSW_SCAN_MEM_MULTIPLIER=2
IRONRAG_PG_HNSW_EXACT_FALLBACK_MAX_ROWS=10000
# IRONRAG_QUERY_RERANK_ENABLED=true
# IRONRAG_QUERY_RERANK_CANDIDATE_LIMIT=24
# Optional provider-backed rerank: off, shadow, or active. Both provider modes
# send the query and bounded candidate excerpts through the configured
# query_rerank profile. Shadow never changes ordering; active falls back deterministically.
# IRONRAG_QUERY_SEMANTIC_RERANK_MODE=off
# Provider decision budget. Must not exceed the 1000 ms turn wait budget when
# mode=active, otherwise startup fails: the active rerank would never call the
# provider and would degrade silently.
# IRONRAG_QUERY_SEMANTIC_RERANK_TIMEOUT_MS=1000
# IRONRAG_QUERY_SEMANTIC_RERANK_CANDIDATE_LIMIT=16
# IRONRAG_QUERY_SEMANTIC_RERANK_CANDIDATE_TEXT_CHARS=1200
# IRONRAG_QUERY_SEMANTIC_RERANK_TOTAL_TEXT_CHARS=18000
# IRONRAG_QUERY_BALANCED_CONTEXT_ENABLED=true
# IRONRAG_QUERY_ANSWER_SOURCE_LINKS_ENABLED=false

# Web crawl defaults.
# IRONRAG_WEB_INGEST_HTTP_TIMEOUT_SECONDS=20
# IRONRAG_WEB_INGEST_MAX_REDIRECTS=10

# Optional runtime policy controls for operator smoke and intervention drills.
# IRONRAG_RUNTIME_POLICY_REJECT_TASK_KINDS=
# IRONRAG_RUNTIME_POLICY_REJECT_TARGET_KINDS=

# OpenTelemetry export.
# Export is OFF by default. To opt in, set IRONRAG_OTEL_ENABLED=true together
# with an endpoint for a collector you control. Traces and metrics may carry
# timings, counters and identifiers. Logs can also carry content and require
# the separate OTEL_LOGS_EXPORTER=otlp opt-in.
IRONRAG_OTEL_ENABLED=false
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=ironrag
# OTEL_DEPLOYMENT_ENVIRONMENT=prod
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=none
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
# Operator-controlled collector using gRPC on :4317:
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4317
# or HTTP/protobuf on :4318:
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4318
# Browser traces are baked into the frontend image at build time.
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4318/v1/traces
# VITE_OTEL_SERVICE_NAME=ironrag-web
# VITE_OTEL_DEPLOYMENT_ENVIRONMENT=prod
# Local frontend developer tools are opt-in so they do not leak into normal UI
# screenshots or demos.
# VITE_ENABLE_QUERY_DEVTOOLS=false

# Optional image overrides for prebuilt or internal deployments.
# IRONRAG_BACKEND_IMAGE=pipingspace/ironrag-backend:latest
# IRONRAG_FRONTEND_IMAGE=pipingspace/ironrag-frontend:latest
# IRONRAG_POSTGRES_IMAGE=postgres:18-alpine
# IRONRAG_REDIS_IMAGE=redis:8.10.1
# IRONRAG_S4CORE_IMAGE=s4core/s4core:latest

# ── Optional: S3 object storage via the bundled s4core (`s4` profile) ────────
# Uncomment all of these together. COMPOSE_PROFILES starts the s4core service;
# the three storage knobs switch IronRAG from filesystem to S3. Endpoint and
# credentials already default to the bundled s4core — override the S3_* vars to
# point at an external bucket instead.
# COMPOSE_PROFILES=s4
# IRONRAG_CONTENT_STORAGE_PROVIDER=s3
# IRONRAG_DEPENDENCY_OBJECT_STORAGE_MODE=bundled
# IRONRAG_CONTENT_STORAGE_TOPOLOGY=shared_cluster
# IRONRAG_CONTENT_STORAGE_S3_BUCKET=ironrag
# IRONRAG_CONTENT_STORAGE_S3_ACCESS_KEY_ID=ironrag
# IRONRAG_CONTENT_STORAGE_S3_SECRET_ACCESS_KEY=ironrag-dev-secret

# ── Optional: local source build instead of pulling published images ─────────
# Run `make docker-local-up` after setting: it derives IRONRAG_VERSION, the
# build identity baked into the image and reported by /v1/version, from git.
# A direct `docker compose up -d --build` must supply it, e.g.
# `IRONRAG_VERSION=$(git describe --always --abbrev=40 --dirty --match '') docker compose up -d --build`; the
# build stops rather than baking a version that never existed.
# IRONRAG_BACKEND_IMAGE=ironrag-backend:local
# IRONRAG_FRONTEND_IMAGE=ironrag-frontend:local

# ── Optional: host sizing — tune per-role CPU and memory caps ────────────────
# The defaults are Docling-capable (≈5.3 GiB steady-state Σ) so one embedded
# extractor can run without relying on kernel OOM recovery. Raise BOTH the CPU
# and memory limit per role for bigger hosts and corpora, or lower the worker
# only for text/native-only local stacks. Same var names as docker-compose.yml;
# values shown are examples for a 16 GiB host, not requirements.
# IRONRAG_FRONTEND_CPUS=1.00
# IRONRAG_FRONTEND_MEMORY_LIMIT=256M
# IRONRAG_CACHE_CPUS=1.00
# IRONRAG_CACHE_MEMORY_LIMIT=768M
# IRONRAG_DB_CPUS=2.00
# IRONRAG_DB_MEMORY_LIMIT=4096M
# IRONRAG_WORKER_CPUS=6.00
# IRONRAG_WORKER_MEMORY_LIMIT=3072M
# IRONRAG_BACKEND_CPUS=6.00
# IRONRAG_BACKEND_MEMORY_LIMIT=3584M
# IRONRAG_S4CORE_CPUS=2.00
# IRONRAG_S4CORE_MEMORY_LIMIT=1024M

# ── Optional: local-dev convenience overrides ────────────────────────────────
# A small local graph-extraction model (e.g. Ollama) can exceed the baked 300s
# idle timeout; raise it for CPU/GPU-constrained runs.
# IRONRAG_RUNTIME_GRAPH_EXTRACT_IDLE_TIMEOUT_SECONDS=1800

# Advanced runtime overrides such as external dependency URLs or manual deployment modes
# are intentionally not listed here to keep the common compose path small.
# See apps/api/.env.example when you need the full runtime surface.
